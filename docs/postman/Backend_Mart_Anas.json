          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Parse response JSON",
                  "const body = pm.response.json();",
                  "",
                  "// Cek apakah request berhasil dan data accessToken ada",
                  "if (res && body.data && body.data.accessToken) {",
                  "    // Simpan token ke environment variable Bruno",
                  "    pm.environment.set(\"admin_token\", body.data.accessToken);",
                  "    console.log(\"Token saved to admin_token!\");",
                  "}"
                ]
              }
            }
          ]
        }
